# Frontend Environment Variables (Vercel / Local)
# Leave VITE_API_URL empty in local dev to use Vite proxy (/api -> http://localhost:5001)
# Set to your Render backend URL on Vercel deployment (e.g. https://eduwrap-backend.onrender.com)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
